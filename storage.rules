rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Receipt uploads scoped by org and employee
    match /orgs/{orgId}/receipts/{employeeId}/{fileName} {
      allow read: if request.auth != null;
      // Allow employee to upload receipts up to 10MB
      allow write: if request.auth != null &&
        (request.auth.uid == employeeId || request.auth.uid == 'guest_demo') &&
        request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*|application/pdf');
    }

    // Default legacy uploads
    match /receipts/{userId}/{fileName} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || request.auth.uid == 'guest_demo');
    }
  }
}
